{
  "name": "@crystal-design/menu-glass",
  "version": "0.1.0",
  "description": "Liquid glass menu and context menu for React",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.lib.ts && tsc -p ."
  },
  "dependencies": {
    "@crystal-design/surface-glass": "^0.1.0",
    "@crystal-design/position": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
