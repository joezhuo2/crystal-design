{
  "name": "@crystal-design/glass",
  "version": "0.1.0",
  "description": "Every Crystal Design component for React in one package",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
