    "@crystal-design/animated-number": "^0.1.0",
    "@crystal-design/button-glass": "^0.1.0",
    "@crystal-design/card-glass": "^0.1.0",
    "@crystal-design/checkbox": "^0.1.0",
    "@crystal-design/color-picker": "^0.1.0",
    "@crystal-design/command-palette-glass": "^0.1.0",
    "@crystal-design/feedback-button": "^0.1.0",
    "@crystal-design/icon-glass": "^0.1.0",
    "@crystal-design/island-glass": "^0.1.0",
    "@crystal-design/menu-glass": "^0.1.0",
    "@crystal-design/modal-glass": "^0.1.0",
    "@crystal-design/navbar-glass": "^0.1.0",
    "@crystal-design/position": "^0.1.0",
